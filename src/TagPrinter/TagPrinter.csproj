<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Emit editor/API documentation; this does not change application behavior. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>TagPrinter</AssemblyName>
    <RootNamespace>TagPrinter</RootNamespace>
    <ApplicationIcon>TagPrinter.ico</ApplicationIcon>
    <Version>0.22.0</Version>
    <Product>TagPrinter</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.28" /><PackageReference Include="ZXing.Net" Version="0.16.11" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="TagPrinter.ico" /><EmbeddedResource Include="GitHub.png" /></ItemGroup>
  <ItemGroup><None Update="config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
